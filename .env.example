# Copy to .env and fill with real local values. Never commit .env.
# Datasource (Aiven MySQL)
MYSQL_HOST=aiven-mysql-host.aivencloud.com
MYSQL_PORT=12345
MYSQL_DATABASE=defaultdb
MYSQL_USER=your-aiven-username
MYSQL_PASSWORD=your-aiven-password
MYSQL_SSL_MODE=REQUIRED

# MongoDB system logging
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/logs
MONGO_LOGGING_ENABLED=true

# Rate limiting
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_PER_MINUTE=100
